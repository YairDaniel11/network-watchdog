<?xml version="1.0" encoding="utf-8"?>
<!-- מצב "כבוי" של כפתורי המעקב (מעקב טלפוני/אינטרנט) - אפור נייטרלי.
     מתחלף עם bg_toggle_on.xml בקוד (MainActivity) לפי מצב המתג בפועל, כך
     שהצבע עצמו - לא רק הטקסט - מסמן אם המעקב פעיל. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/toggle_off_gray" />
            <stroke android:width="3dp" android:color="@color/focus_green" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/toggle_off_gray" />
            <stroke android:width="3dp" android:color="@color/focus_green" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/toggle_off_gray" />
        </shape>
    </item>

</selector>
